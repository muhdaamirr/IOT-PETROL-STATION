/* USER CODE BEGIN Header_StartTankTask */
/**
  * @brief  Function implementing the TankTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartTankTask */
void StartTankTask(void *argument)
{
  /* USER CODE BEGIN 5 */

	for(;;)
	{
		if(pump1Running)
		{
			if(tankVolume >= 10)
			{
			    tankVolume -= 10;
			}
		    pump1Count++;
		}

		if(pump2Running)
		{
			if(tankVolume >= 10)
			{
			    tankVolume -= 10;
			}
		    pump2Count++;
		}

		if(pump3Running)
		{
			if(tankVolume >= 10)
			{
			    tankVolume -= 10;
			}
		    pump3Count++;
		}

		if(pump4Running)
		{
			if(tankVolume >= 10)
			{
			    tankVolume -= 10;
			}
		    pump4Count++;
		}

	    osDelay(1000);
	}

  /* USER CODE END 5 */
}

/* USER CODE BEGIN Header_StartEventTask */
/**
* @brief Function implementing the EventTask thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartEventTask */
void StartEventTask(void *argument)
{
    uint8_t prevPA0 = 0;
    uint8_t prevPA1 = 0;
    uint8_t prevPB0 = 0;
    uint8_t prevPB1 = 0;

    for(;;)
    {
        pump1Running =
            HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);

        pump2Running =
            HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_1);

        pump3Running =
        	    HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_2);

        pump4Running =
        	    HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_3);

        osDelay(20);
    }
}

/* USER CODE BEGIN Header_StartMQTTTask */
/**
* @brief Function implementing the MQTTTask thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartMQTTTask */
void StartMQTTTask(void *argument)
{
  /* USER CODE BEGIN StartMQTTTask */

  char msg[100];

  for(;;)
  {

      osMutexAcquire(
              TankMutexHandle,
              osWaitForever);

      sprintf(msg,
              "Tank=%lu,P1=%lu,P2=%lu,P3=%lu,P4=%lu\r\n",
              tankVolume,
			  pump1Count,
              pump2Count,
              pump3Count,
              pump4Count);

      char msgPump[50];

      sprintf(msgPump,
              "P1=%lu,P2=%lu,P3=%lu,P4=%lu\r\n",
              pump1Count,
              pump2Count,
              pump3Count,
              pump4Count);

      HAL_UART_Transmit(
              &huart1,
              (uint8_t*)msgPump,
              strlen(msgPump),
              HAL_MAX_DELAY);
      osMutexRelease(
              TankMutexHandle);

      osDelay(100);

  }
  /* USER CODE END StartMQTTTask */
}

